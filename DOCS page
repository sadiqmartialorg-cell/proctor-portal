<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Upload Documents — Talview</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
body{background:#0f1117;color:#e2e8f0;font-family:'Segoe UI',Arial,sans-serif;min-height:100vh;}
.header{background:#1B3A6B;padding:16px 32px;display:flex;align-items:center;gap:12px;}
.logo{font-size:20px;font-weight:800;color:#fff;letter-spacing:-.02em;}
.sub{font-size:13px;color:#BDD7EE;}
.container{max-width:700px;margin:40px auto;padding:0 20px;}
.welcome-card{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:24px;margin-bottom:32px;}
.welcome-card h2{font-size:20px;font-weight:700;color:#f1f5f9;margin-bottom:4px;}
.welcome-card p{font-size:14px;color:#94a3b8;}
.badge{display:inline-block;background:#2E75B6;color:#fff;padding:2px 10px;border-radius:20px;font-size:12px;font-weight:600;margin-left:8px;}
.doc-list{display:flex;flex-direction:column;gap:12px;margin-bottom:32px;}
.doc-item{background:#1e293b;border:1px solid #334155;border-radius:10px;padding:16px 20px;display:flex;align-items:center;gap:16px;transition:border-color .2s;}
.doc-item.uploaded{border-color:#22543D;background:#0f2318;}
.doc-item.uploading{border-color:#2E75B6;background:#0f1f38;}
.doc-icon{font-size:28px;width:40px;text-align:center;flex-shrink:0;}
.doc-info{flex:1;}
.doc-name{font-size:14px;font-weight:600;color:#f1f5f9;margin-bottom:2px;}
.doc-hint{font-size:12px;color:#64748b;}
.doc-filename{font-size:12px;color:#22c55e;margin-top:4px;word-break:break-all;}
.doc-status{font-size:12px;font-weight:600;margin-left:8px;white-space:nowrap;}
.doc-status.ok{color:#22c55e;}
.doc-status.err{color:#fc8181;}
.upload-btn{background:#2E75B6;border:none;color:#fff;padding:8px 16px;border-radius:6px;cursor:pointer;font-size:13px;font-weight:600;white-space:nowrap;flex-shrink:0;}
.upload-btn:hover{background:#1B3A6B;}
.upload-btn.uploaded{background:#22543D;}
.progress-section{background:#1e293b;border:1px solid #334155;border-radius:10px;padding:16px 20px;margin-bottom:24px;}
.progress-label{font-size:13px;color:#94a3b8;margin-bottom:8px;display:flex;justify-content:space-between;}
.progress-bar{height:8px;background:#0f1117;border-radius:4px;overflow:hidden;}
.progress-fill{height:100%;background:linear-gradient(90deg,#2E75B6,#22c55e);border-radius:4px;transition:width .4s;}
.submit-btn{width:100%;background:#22543D;color:#fff;border:none;padding:16px;border-radius:8px;font-size:16px;font-weight:700;cursor:pointer;}
.submit-btn:hover{background:#276749;}
.submit-btn:disabled{background:#1e293b;color:#4a5568;cursor:not-allowed;}
.err-banner{background:rgba(252,129,129,.08);border:1px solid rgba(252,129,129,.3);border-radius:8px;padding:12px 16px;color:#fc8181;font-size:13px;margin-bottom:16px;display:none;}
.success-screen{display:none;text-align:center;padding:80px 32px;}
.success-screen .icon{font-size:72px;margin-bottom:16px;}
.success-screen h2{font-size:26px;font-weight:700;color:#22c55e;margin-bottom:8px;}
.success-screen p{color:#94a3b8;font-size:15px;}
</style>
</head>
<body>
<div class="header">
  <div class="logo">Talview</div>
  <div class="sub">Document Submission Portal</div>
</div>

<div class="container">
  <div id="mainContent">
    <div class="welcome-card">
      <h2>Hello, <span id="proctorName">...</span> 👋</h2>
      <p style="margin-top:4px;font-size:13px;color:#64748b;" id="proctorEmail"></p>
      <p style="margin-top:12px;">Please upload all <strong>6 mandatory documents</strong> below. All documents must be uploaded before you can submit.</p>
    </div>

    <div class="progress-section">
      <div class="progress-label">
        <span>Documents uploaded</span>
        <span id="progressCount">0 / 6</span>
      </div>
      <div class="progress-bar"><div class="progress-fill" id="progressFill" style="width:0%"></div></div>
    </div>

    <div class="doc-list" id="docList">
      <!-- Rendered by JS -->
    </div>

    <div class="err-banner" id="errBanner"></div>
    <button class="submit-btn" id="submitBtn" onclick="submitDocs()" disabled>📤 Submit All Documents</button>
    <p style="text-align:center;font-size:12px;color:#4a5568;margin-top:12px;">These documents are unique to your account and securely stored.</p>
  </div>

  <div class="success-screen" id="successScreen">
    <div class="icon">✅</div>
    <h2>Documents Submitted!</h2>
    <p id="successMsg">All your documents have been securely submitted to Talview.<br/>The team will review and get in touch with you shortly.</p>
    <p style="color:#4a5568;font-size:12px;margin-top:24px;">You can close this window.</p>
  </div>
</div>

<script>
const SB_URL='https://vukijbppuchsmwoyrbjt.supabase.co';
const SB_KEY='eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ1a2lqYnBwdWNoc213b3lyYmp0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDI0OTEyMzMsImV4cCI6MjA1ODA2NzIzM30.c9_0jMsFH9eGN9J0q7QhKmFbOKW7jZSgBFYWxVHpMOA';
const SB_STORAGE='https://vukijbppuchsmwoyrbjt.supabase.co/storage/v1';
const BREVO_API_KEY='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';
const BREVO_DL='managedservices@talview.com';
const BREVO_SENDER={name:'Talview Managed Services',email:'sadiq.a@talview.com'};

const params=new URLSearchParams(location.search);
const proctorId=params.get('pid')||'';
let proctorData=null;

const DOCS=[
  {id:'doc_resume',label:'Resume / CV',hint:'PDF or image, max 10MB',icon:'📄',dbCol:'doc_resume'},
  {id:'doc_passport_photo',label:'Passport-size Photograph',hint:'Recent photo with clear face',icon:'🖼️',dbCol:'doc_passport_photo'},
  {id:'doc_grad_cert',label:'Graduation Completion Certificate',hint:'Degree or provisional certificate',icon:'🎓',dbCol:'doc_grad_cert'},
  {id:'doc_aadhaar',label:'Aadhaar Card Copy',hint:'Both sides visible, clear scan',icon:'🪪',dbCol:'doc_aadhaar_copy'},
  {id:'doc_pan',label:'PAN Card Copy',hint:'Clear and legible',icon:'💳',dbCol:'doc_pan_copy'},
  {id:'doc_eye_test',label:'Eye Test Certificate',hint:'Recent (within 1 year)',icon:'👁️',dbCol:'doc_eye_test'},
];

const uploadedUrls={};
const uploadedFiles={};

function renderDocs(){
  document.getElementById('docList').innerHTML=DOCS.map(d=>`
    <div class="doc-item" id="item_${d.id}">
      <div class="doc-icon">${d.icon}</div>
      <div class="doc-info">
        <div class="doc-name">${d.label} <span style="color:#fc8181;font-size:11px;">*</span></div>
        <div class="doc-hint">${d.hint}</div>
        <div class="doc-filename" id="fn_${d.id}" style="display:none;"></div>
      </div>
      <span class="doc-status" id="st_${d.id}" style="color:#64748b;">Not uploaded</span>
      <input type="file" id="file_${d.id}" accept="image/*,.pdf" style="display:none;" onchange="handleFile('${d.id}',this)"/>
      <button class="upload-btn" id="btn_${d.id}" onclick="document.getElementById('file_${d.id}').click()">Upload</button>
    </div>
  `).join('');
}

function handleFile(docId, input){
  const file=input.files[0];if(!file)return;
  if(file.size>10*1024*1024){alert('File is too large (max 10MB). Please compress and try again.');input.value='';return;}
  uploadedFiles[docId]=file;
  document.getElementById('fn_'+docId).textContent=file.name;
  document.getElementById('fn_'+docId).style.display='block';
  document.getElementById('st_'+docId).textContent='✅ Ready';
  document.getElementById('st_'+docId).className='doc-status ok';
  document.getElementById('btn_'+docId).textContent='Change';
  document.getElementById('btn_'+docId).className='upload-btn uploaded';
  document.getElementById('item_'+docId).className='doc-item uploaded';
  updateProgress();
}

function updateProgress(){
  const count=Object.keys(uploadedFiles).length;
  document.getElementById('progressCount').textContent=`${count} / 6`;
  document.getElementById('progressFill').style.width=Math.round(count/6*100)+'%';
  document.getElementById('submitBtn').disabled=count<6;
}

async function init(){
  if(!proctorId){showError('Invalid link. Please contact managedservices@talview.com');return;}
  try{
    const r=await fetch(`${SB_URL}/rest/v1/proctors?id=eq.${proctorId}`,{headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY}});
    const rows=await r.json();
    if(!rows||!rows.length){showError('Proctor not found. Please check your link.');return;}
    proctorData=rows[0];
    document.getElementById('proctorName').textContent=proctorData.name||'Proctor';
    document.getElementById('proctorEmail').textContent=proctorData.email||'';
    // Check if already submitted
    const allDocsSubmitted=DOCS.every(d=>proctorData[d.dbCol]);
    if(allDocsSubmitted){showSuccess(proctorData.name,'You have already submitted all your documents. Thank you!');return;}
  }catch(e){console.warn('Load failed:',e);}
  renderDocs();
}

async function submitDocs(){
  if(Object.keys(uploadedFiles).length<6){
    document.getElementById('errBanner').textContent='Please upload all 6 documents before submitting.';
    document.getElementById('errBanner').style.display='block';return;
  }
  document.getElementById('errBanner').style.display='none';
  document.getElementById('submitBtn').disabled=true;
  document.getElementById('submitBtn').textContent='Uploading...';
  try{
    const dbUpdate={};
    let i=0;
    for(const doc of DOCS){
      i++;
      document.getElementById('submitBtn').textContent=`Uploading ${i}/6...`;
      const file=uploadedFiles[doc.id];
      const ext=file.name.split('.').pop();
      const fname=`${proctorId}_${doc.dbCol}.${ext}`;
      const uploadUrl=`${SB_STORAGE}/object/bgv-documents/${fname}`;
      const resp=await fetch(uploadUrl,{method:'POST',headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY,'Content-Type':file.type,'x-upsert':'true'},body:file});
      if(!resp.ok)throw new Error(`Upload failed for ${doc.label}: ${resp.status}`);
      dbUpdate[doc.dbCol]=`${SB_STORAGE}/object/public/bgv-documents/${fname}`;
      // Update status indicator
      document.getElementById('st_'+doc.id).textContent='☁️ Uploaded';
    }
    document.getElementById('submitBtn').textContent='Saving...';
    dbUpdate.upd=new Date().toISOString();
    await fetch(`${SB_URL}/rest/v1/proctors?id=eq.${proctorId}`,{
      method:'PATCH',
      headers:{'apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY,'Content-Type':'application/json','Prefer':'return=minimal'},
      body:JSON.stringify(dbUpdate)
    });
    // Notify team
    await notifyTeam();
    showSuccess(proctorData?.name||'Proctor');
  }catch(e){
    document.getElementById('submitBtn').disabled=false;
    document.getElementById('submitBtn').textContent='📤 Submit All Documents';
    document.getElementById('errBanner').textContent='Error: '+e.message+'. Please try again.';
    document.getElementById('errBanner').style.display='block';
    console.error(e);
  }
}

async function notifyTeam(){
  try{
    await fetch('https://api.brevo.com/v3/smtp/email',{
      method:'POST',
      headers:{'accept':'application/json','api-key':BREVO_API_KEY,'content-type':'application/json'},
      body:JSON.stringify({
        sender:BREVO_SENDER,
        to:[{email:BREVO_DL}],
        subject:`[Documents Received] ${proctorData?.name||proctorId} has submitted all 6 documents`,
        htmlContent:`<h2>Document Submission Complete ✅</h2>
          <p>${proctorData?.name||'A proctor'} (${proctorData?.email||proctorId}) has uploaded all 6 required documents.</p>
          <p>Log in to the Proctor Management Portal → In Progress to review and verify.</p>`
      })
    });
  }catch(e){console.warn('Notification failed:',e.message);}
}

function showSuccess(name,msg){
  document.getElementById('mainContent').style.display='none';
  document.getElementById('successScreen').style.display='block';
  if(msg)document.getElementById('successMsg').textContent=msg;
  else document.getElementById('successMsg').innerHTML=`All documents submitted successfully, <strong>${name}</strong>.<br/>The Talview team will review and contact you shortly.`;
}
function showError(msg){
  document.querySelector('.container').innerHTML=`<div style="text-align:center;padding:80px 20px;"><div style="font-size:56px;margin-bottom:16px;">⚠️</div><h2 style="color:#fc8181;margin-bottom:8px;">${msg}</h2><p style="color:#94a3b8;font-size:13px;">If you believe this is an error, contact managedservices@talview.com</p></div>`;
}

init();
</script>
</body>
</html>
